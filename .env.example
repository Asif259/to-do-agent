# Copy to .env.local and edit.
# Models are not configured here. Open "Model configuration" in the app to add API keys.

# live = use the models you configured.  mock = offline demo with placeholder results.
LLM_MODE=live

# How many workers run at once (1-8). The reviewer is always a single lane.
WORKER_CONCURRENCY=3

# Storage: Defaults to in-memory with browser localStorage/cookie sync.
# Set a file path if you explicitly want a disk SQLite database.
# TODO_DB=:memory:

# Phone on the same Wi-Fi: set a long random token, then run `npm run dev:lan`.
# ACCESS_TOKEN=
