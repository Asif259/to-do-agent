# Copy to .env and edit. Real environment variables take priority.

# Require "Authorization: Bearer <this>" on /v1/* and /admin/*. Empty = open (localhost only!).
PROXY_API_KEY=

HOST=127.0.0.1
PORT=8000
DB_URL=sqlite+aiosqlite:///./router.db

# Seconds
CONNECT_TIMEOUT=10
READ_TIMEOUT=120
FIRST_BYTE_TIMEOUT=30

# Upper bound on upstream tries per request
MAX_ATTEMPTS=20
